{
  "name": "opencontainer",
  "version": "1.0.0-beta.2",
  "description": "Browser-native Node.js runtime \u2014 real Node v26 lib tree, the real npm CLI, OPFS-backed VFS. A drop-in, open-source WebContainers alternative: npm install and boot, nothing to host.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imtia33/opencontainer.git"
  },
  "bugs": {
    "url": "https://github.com/imtia33/opencontainer/issues"
  },
  "homepage": "https://github.com/imtia33/opencontainer#readme",
  "keywords": [
    "webcontainers",
    "nodejs",
    "npm",
    "browser",
    "runtime",
    "virtual-filesystem",
    "opfs",
    "web-worker",
    "stackblitz-alternative",
    "in-browser"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/opencontainer.mjs",
  "module": "./dist/opencontainer.mjs",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/opencontainer.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-types",
    "public",
    "README.md",
    "LICENSE",
    "COMPATIBILITY.md"
  ],
  "scripts": {
    "build": "bash scripts/build-opencontainer.sh && bun run scripts/build-dist.ts",
    "build:kernel": "bash scripts/build-opencontainer.sh",
    "build:dist": "bun run scripts/build-dist.ts",
    "test:harness": "bun run scripts/npm-harness.ts -v",
    "test:buffer-parity": "bun run scripts/test-buffer-parity.ts && node scripts/test-buffer-parity.node.cjs",
    "test:http-client": "bun run scripts/test-http-client.ts",
    "prepublishOnly": "npm run build",
    "test:zlib": "bun run scripts/test-zlib.ts",
    "test:npm-real": "bun run scripts/test-npm-real.ts",
    "test:node-api": "bun run scripts/test-node-api.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "bun-types": "^1.3.4",
    "fflate": "^0.8.3",
    "typescript": "^5"
  }
}